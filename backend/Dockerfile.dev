FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Dependencies are installed at container start with `npm i`
# (node_modules lives in a named volume — incremental installs).
EXPOSE 3000

CMD ["npm", "run", "dev"]
