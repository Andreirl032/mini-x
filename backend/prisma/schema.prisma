// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUM

enum Role {
  ADMIN
  USER
}

// --------------------------------------------------
// TABELAS (Models)
// --------------------------------------------------

model User {
  id              String    @id @default(cuid(2))
  username        String    @unique
  name            String
  email           String    @unique
  password        String
  role            Role      @default(USER)
  profile_picture String?
  bio             String?
  birth_date      DateTime?
  city            String?
  country_code    String?
  google_id       String?   @unique
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  posts Post[]
  likes Like[]

  followers Follow[] @relation("FollowedUser")
  following Follow[] @relation("FollowingUser")

  sessions Session[]

  @@map("users")
}

model Follow {
  id          String   @id @default(cuid(2))
  follower_id String
  followed_id String
  created_at  DateTime @default(now())

  follower User @relation("FollowingUser", fields: [follower_id], references: [id], onDelete: Cascade)
  followed User @relation("FollowedUser", fields: [followed_id], references: [id], onDelete: Cascade)

  @@unique([followed_id, follower_id])
  @@index([follower_id])
  @@map("following")
}

model Like {
  id         String   @id @default(cuid(2))
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([post_id])
  @@map("likes")
}

model Post {
  id         String   @id @default(cuid(2))
  user_id    String?
  parent_id  String?
  body       String?
  image      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  is_deleted Boolean @default(false)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  parent  Post?  @relation("PostReplies", fields: [parent_id], references: [id])
  replies Post[] @relation("PostReplies")

  likes Like[]

  @@index([created_at])
  @@index([user_id])
  @@index([parent_id])
  @@map("posts")
}

model Session {
  id         String   @id @default(cuid(2))
  user_id    String
  token      String   @unique //Refresh token
  expires_at DateTime
  ip_address String? // ex: "192.168.0.1"
  user_agent String? // ex: "Mozilla/5.0 (Windows NT 10.0...)"
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("sessions")
}
